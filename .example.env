# =============== API服务器配置 ===============
API_HOST=localhost
API_PORT=8031
API_RELOAD=false

# =============== DeepSeek API配置 ===============
# 从 https://platform.deepseek.com/ 获取API密钥
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# =============== Embedding配置 ===============
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu

# =============== 存储配置 ===============
PERSIST_DIR=./chroma_dsm5_db

# =============== 文档文件配置 ===============
# 支持目录或单个文件路径
DOCUMENTS_PATH=./dsm5_documents

# =============== 检索配置 ===============
DEFAULT_MODE=HYBRID
DEFAULT_TOP_K=5
DEFAULT_VECTOR_WEIGHT=0.7

# =============== BM25 关键词索引配置 ===============
# 关键词通道停用词语言：en/de/nl/fr/es/pt/it/ru/sv/no/zh/tr/ko/da
BM25_LANGUAGE=en
# 设为 true 可关闭词干化（disorder 与 disorders 将严格区分）
BM25_SKIP_STEMMING=false

# =============== HuggingFace镜像站配置 ===============
HF_ENDPOINT=https://hf-mirror.com

# =============== CORS配置 ===============
CORS_ORIGINS=*

# =============== 日志配置 ===============
LOG_LEVEL=INFO

# =============== 模型目录配置 ===============
MODELS_DIR=./models

# =============== 优化配置 ===============
SIMILARITY_CUTOFF=0.2
ENABLE_CONTEXT_REORDER=true
ENABLE_METADATA_REPLACEMENT=false
MAX_SOURCES=3
# 批量查询单请求并发上限（asyncio.Semaphore）
BATCH_CONCURRENCY=4
# 流式回答拼进提示词的上下文长度上限（字符）
STREAM_CONTEXT_CHAR_LIMIT=24000

# =============== 文档解析配置 ===============
CHUNK_SIZE=1024
CHUNK_OVERLAP=100
MAX_FILE_SIZE_MB=50
